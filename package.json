{
  "name": "dial-dash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:workspace": "powershell -ExecutionPolicy Bypass -File scripts/launch-workspace.ps1",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild && node scripts/package-sites-build.mjs",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint app components lib --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "validate:data": "npx tsx scripts/validate-data.ts",
    "validate:pilot": "npx tsx scripts/validate-pilot.ts",
    "validate:methodology": "npx tsx scripts/validate-methodology.ts",
    "audit:actionability": "npx tsx scripts/audit-actionability.ts",
    "refresh:media": "npx tsx scripts/refresh-media-freshness.ts",
    "rank:prospects": "npx tsx scripts/rank-prospects.ts",
    "research:batch": "npx tsx scripts/create-research-batch.ts",
    "pilot:research": "npx tsx scripts/research-pilot.ts",
    "source:dry-run": "npx tsx scripts/source-dry-run.ts",
    "refresh": "npx tsx scripts/refresh-followers.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "crawlee": "^3.16.0",
    "date-fns": "^4.1.0",
    "dialkit": "^1.3.0",
    "fast-xml-parser": "^5.9.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "graphology-types": "^0.24.8",
    "lucide-react": "^0.477.0",
    "motion": "^12.40.0",
    "next": "15.2.9",
    "playwright": "^1.60.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sigma": "^3.0.2",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.5.1",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.2.9",
    "postcss": "^8.5.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wrangler": "4.23.0"
  }
}
